<style>
    .doi-doc-link {
        align-items: center;
        background: #f7f8fa;
        border: 1px solid #d8dce2;
        border-left: 4px solid #d72d26;
        display: flex;
        gap: 16px;
        justify-content: space-between;
        margin: 20px 0;
        padding: 16px 18px;
    }
    .doi-doc-link h4 { font-size: 15px; font-weight: 700; margin: 0 0 4px; }
    .doi-doc-link p { color: #5f6670; line-height: 1.45; margin: 0; }
    .doi-doc-link__button { flex: 0 0 auto; }
    @media (max-width: 640px) {
        .doi-doc-link { align-items: flex-start; flex-direction: column; }
    }
</style>

<section class="doi-doc-link">
    <div>
        <h4>{{ 'jw.doi.integration.documentation.title'|trans }}</h4>
        <p>{{ 'jw.doi.integration.documentation.body'|trans }}</p>
    </div>
    <a class="btn btn-primary doi-doc-link__button" href="{{ path('doiconfirm_documentation') }}">
        <i class="ri-book-open-line" aria-hidden="true"></i>
        {{ 'jw.doi.integration.documentation.open'|trans }}
    </a>
</section>
