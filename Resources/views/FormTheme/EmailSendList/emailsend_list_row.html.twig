{% use '@MauticEmail/FormTheme/EmailSendList/emailsend_list_row.html.twig' with emailsend_list_row as mautic_emailsend_list_row %}

{% block jw_mautic_form_type_jw_emailsend_list_row %}
<style>
    .doi-native-email-controls > .row {
        margin-left: 0;
        margin-right: 0;
    }
    .doi-native-email-controls > .row > [class*="col-"] {
        padding-left: 0 !important;
        padding-right: 0 !important;
    }
    .doi-field-width {
        box-sizing: border-box;
        width: calc(100% - 30px);
    }
</style>
<div class="doi-native-email-controls doi-field-width">
    <div class="mb-sm">
        <span
            class="control-label fw-b"
            data-toggle="tooltip"
            data-container="body"
            data-placement="top"
            title=""
            data-original-title="{{ 'jw.mautic.email.form.action.doi_email.tooltip'|trans }}"
        >
            {{ 'jw.mautic.email.form.action.doi_email.title'|trans }}
            <i class="ri-question-line"></i>
        </span>
    </div>
    {{ block('mautic_emailsend_list_row') }}
</div>

{% if form.send_owner_email is defined and form.owner_email is defined %}
    {% set ownerEnabled = form.send_owner_email.vars.checked|default(false) %}
    {{ form_row(form.send_owner_email) }}
    <div
        id="{{ form.owner_email.vars.id }}_container"
        class="doi-owner-email-fields doi-field-width{% if not ownerEnabled %} hide{% endif %}"
        {% if not ownerEnabled %}hidden style="display:none"{% endif %}
    >
        <div class="mb-sm">
            <span
                class="control-label fw-b"
                data-toggle="tooltip"
                data-container="body"
                data-placement="top"
                title=""
                data-original-title="{{ 'jw.mautic.email.form.action.owner_email.tooltip'|trans }}"
            >
                {{ 'jw.mautic.email.form.action.owner_email.title'|trans }}
                <i class="ri-question-line"></i>
            </span>
        </div>
        <div class="doi-native-email-controls">
            {% with {'form': form.owner_email.useremail} %}
                {{ block('mautic_emailsend_list_row') }}
            {% endwith %}
        </div>
        {{ form_row(form.owner_email.user_id) }}
    </div>
    {% do form.owner_email.setRendered() %}
{% endif %}

{{ form_rest(form) }}
{% endblock %}
