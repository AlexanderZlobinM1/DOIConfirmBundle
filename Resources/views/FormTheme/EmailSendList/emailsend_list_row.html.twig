{% use '@MauticEmail/FormTheme/EmailSendList/emailsend_list_row.html.twig' with emailsend_list_row as mautic_emailsend_list_row %}

{% block jw_mautic_form_type_jw_emailsend_list_row %}
<style>
    .doi-native-email-controls > .row {
        margin-left: 0;
        margin-right: 0;
    }
    .doi-native-email-controls > .row > [class*="col-"] {
        padding-left: 0 !important;
        padding-right: 0 !important;
    }
</style>
<div class="doi-native-email-controls">
    {{ block('mautic_emailsend_list_row') }}
</div>

{% if form.send_owner_email is defined and form.owner_email is defined %}
    {% set ownerEnabled = form.send_owner_email.vars.checked|default(false) %}
    {{ form_row(form.send_owner_email) }}
    <div
        id="{{ form.owner_email.vars.id }}_container"
        class="doi-owner-email-fields{% if not ownerEnabled %} hide{% endif %}"
        {% if not ownerEnabled %}hidden style="display:none"{% endif %}
    >
        <div class="doi-native-email-controls">
            {% with {'form': form.owner_email.useremail} %}
                {{ block('mautic_emailsend_list_row') }}
            {% endwith %}
        </div>
        {{ form_row(form.owner_email.user_id) }}
    </div>
    {% do form.owner_email.setRendered() %}
{% endif %}

{{ form_rest(form) }}
{% endblock %}
