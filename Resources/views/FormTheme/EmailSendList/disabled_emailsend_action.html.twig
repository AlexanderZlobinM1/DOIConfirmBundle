{% extends '@MauticForm/Action/base_form_action.html.twig' %}

{% block panel_classes %}doi-action-disabled{% endblock %}

{% block content %}
    <script>
        (function () {
            function hideDoiActionOption() {
                var option = document.getElementById('action_jw.email.send.lead');
                if (!option) {
                    return;
                }

                var select = option.closest('select');
                option.remove();

                if (window.mQuery && select) {
                    window.mQuery(select).trigger('chosen:updated');
                }
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', hideDoiActionOption);
            } else {
                hideDoiActionOption();
            }
        }());
    </script>

    <style>
        .doi-action-disabled {
            border-style: dashed;
            opacity: .68;
        }

        .doi-action-disabled .doi-action-disabled__status {
            display: inline-block;
            margin-left: 8px;
            padding: 2px 8px;
            border: 1px solid #b8b8b8;
            border-radius: 4px;
            color: #5f5f5f;
            font-size: 11px;
            font-weight: 600;
            line-height: 1.4;
            text-transform: uppercase;
        }

        .doi-action-disabled .action-descr {
            display: block;
            margin-top: 6px;
        }
    </style>

    <span class="action-label">{{ action.name }}</span>
    <span class="doi-action-disabled__status">{{ 'jw.mautic.email.form.action.sendemail.lead.disabled.status'|trans }}</span>

    <span class="action-descr">
        {{ 'jw.mautic.email.form.action.sendemail.lead.disabled.descr'|trans }}
    </span>
{% endblock %}
